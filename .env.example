# PostgreSQL / PostGIS
POSTGRES_DB=geopulse
POSTGRES_USER=geopulse
POSTGRES_PASSWORD=geopulse_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# Django
DJANGO_SECRET_KEY=dev-secret-key-change-in-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# Go Ingestion Service
INGEST_PORT=8080

# Frontend (Vite)
VITE_API_URL=/api
VITE_WS_URL=ws://localhost/ws
